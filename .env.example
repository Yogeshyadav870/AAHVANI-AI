# Optional: without a key, AAHVANI AI uses deterministic local demo responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: bidirectional low-latency voice mode.
# Create a key in Google AI Studio and keep it only in your local .env file.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Kore

# Optional speech settings for the record/transcribe + Edge TTS fallback.
WHISPER_MODEL=base
EDGE_TTS_VOICE=en-IN-NeerjaNeural

# Local Gradio server
HOST=127.0.0.1
PORT=7860
